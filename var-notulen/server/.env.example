# Welke transcriptie-engine gebruiken:
#   local  = draait volledig op deze server (whisper.cpp), geen data naar derden, gratis, wel
#            zwaarder voor de CPU en vereist build-tools + ffmpeg (zie README)
#   openai = stuurt audiofragmenten naar de OpenAI Whisper API, sneller/lichter, kost geld per
#            minuut, vereist een OPENAI_API_KEY
TRANSCRIPTION_ENGINE=local

# Alleen relevant als TRANSCRIPTION_ENGINE=local: welk Whisper-model.
# Van klein/snel naar groot/nauwkeurig: tiny, base, small, medium, large-v3-turbo, large.
# "small" is een goede standaard voor Nederlandse VAR-vergaderingen.
WHISPER_LOCAL_MODEL=small

# Alleen relevant als TRANSCRIPTION_ENGINE=local en je een GPU-server met CUDA hebt
WHISPER_USE_CUDA=false

# Alleen verplicht als TRANSCRIPTION_ENGINE=openai
OPENAI_API_KEY=sk-...

# Verplicht: wachtwoord waarmee de VAR-leden toegang krijgen tot de tool
VAR_APP_PASSWORD=kies-een-sterk-wachtwoord

# Verplicht: willekeurige, geheime string voor het ondertekenen van sessies
SESSION_SECRET=kies-een-lange-willekeurige-string

# Optioneel: poort waarop de server draait (standaard 3000)
PORT=3000
