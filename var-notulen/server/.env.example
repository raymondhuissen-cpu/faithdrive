# Verplicht: API key van OpenAI (voor Whisper-transcriptie)
OPENAI_API_KEY=sk-...

# Verplicht: wachtwoord waarmee de VAR-leden toegang krijgen tot de tool
VAR_APP_PASSWORD=kies-een-sterk-wachtwoord

# Verplicht: willekeurige, geheime string voor het ondertekenen van sessies
SESSION_SECRET=kies-een-lange-willekeurige-string

# Optioneel: poort waarop de server draait (standaard 3000)
PORT=3000
